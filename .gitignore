# 编译缓存
__pycache__/
*.pyc
.pytest_cache/

# 本地配置
.deepseek/

# 打包备份（不进版本库）
*.zip
*.tar.gz

# API 密钥（明文 key 严禁入库，改用环境变量 AGNES_API_KEY / AGNES_BASE_URL）
backend/config.json

# Agent 运行产物（可重新生成）
backend/cache/
backend/results/
backend/dataset_files/

# 前端依赖
前端/proxy-server/node_modules/

# 数据层原始交付文件（图谱 JSON + 书 + 视频，约 4.6GB，不进版本库；分层产物在 data/layered/）
数据/

# 用户账号数据（运行期状态，含密码哈希；首个注册用户自动成为管理员）
data/users.json

# 个人状态数据（笔记/收藏/临时关系/筛选，运行期状态；首次保存时才生成）
data/profiles.json

# 前端交付副本（已合并进 SUFE-Knowledge-Galaxy，验证后由用户删除）
前端/SUFE-Knowledge-Galaxy(新)/
前端/SUFE-Knowledge-Galaxy最新版/

# 视频文件与封面（约 4.8GB，后端 data/media/ 托管，由 scripts/import_videos.py 生成；
# 清单 data/media/videos.json 进库，论文 PDF 与图书封面体积小也进库）
data/media/videos/

# 教材原文（约 378MB，后端 data/media/ 托管，由 scripts/import_textbooks.py 从根目录 书/ 生成；
# 清单 data/media/textbooks.json 进库）
data/media/textbooks/

# 教材原始取材目录（用户放在根目录的 20 本书，约 378MB，仅作为 import_textbooks.py 的输入，不进版本库）
书/

# 前端知识星系 v12 本地兜底 JSON（34.5MB，与 data/layered/v12_layered.json 同源，不进版本库）
前端/SUFE-Knowledge-Galaxy/data/galaxy_v12.json

# 上一次交给服务器部署负责人的旧快照（本地比对基准，自带 .git，严禁入库）
上财项目/
# 部署更新包：压缩件由上面的 *.zip 规则忽略，只有 更新清单.txt（含 SHA256 指纹）进库
